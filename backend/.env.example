# ─────────────────────────────────────────────────────────────────────────────
# Backend-local environment — read by app.config.Settings when uvicorn is run
# from this directory (the non-Docker path). Under Docker Compose the root
# .env is passed in instead; see ../.env.example for the full list.
#
#   cp .env.example .env          and paste in a key
#
# This file is committed; .env is not. Keep real keys out of it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Reasoning layer: pick either provider, or set both ───────────────────────
# Whichever keys are present decide which models the AI panel offers. One is
# enough; with neither, ATLAS falls back to deterministic grounded reasoning and
# the app still runs.

# Google AI Studio — Gemini, called directly. https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenRouter — one key for Claude, GPT, Gemini, Grok, DeepSeek, Qwen, GLM, Kimi
# and a free NVIDIA model. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Starting model, until an operator picks another in the panel. Google ids are
# bare (gemini-3.5-flash-lite); OpenRouter ids carry the vendor prefix
# (anthropic/claude-sonnet-5) — that prefix is how the backend routes the call.
LLM_MODEL=gemini-3.5-flash-lite

# false → deterministic answers only, no model calls at all.
LLM_ENABLED=true

# ── OpenRouter extras (optional) ─────────────────────────────────────────────
# Attribution on OpenRouter's dashboards. No effect on routing or billing.
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=ABC Logistics Control Tower

# Voice, when an OpenRouter model is active. The TTS default is the same Gemini
# model the Google-direct path uses, so the spoken answers sound the same.
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
OPENROUTER_STT_MODEL=openai/whisper-large-v3

# ── Infrastructure (optional locally) ────────────────────────────────────────
# Omit DATABASE_URL to fall back to SQLite at ./clt_local.db, and REDIS_URL to
# run without Redis (the model choice then resets on restart).
# DATABASE_URL=postgresql+asyncpg://clt:clt_secret@localhost:5432/clt_db
# REDIS_URL=redis://localhost:6379/0
DEMO_MODE=true
