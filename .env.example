# ─────────────────────────────────────────────────────────────────────────────
# Centrica Logistics Control Tower — environment template
#
#   cp .env.example .env          and fill in what you need
#
# This file is committed; .env is not. Docker Compose feeds this file to the
# backend container (`env_file: .env`), so everything the backend reads can live
# here. Running the backend directly instead (uvicorn from ./backend) makes it
# read backend/.env — see backend/.env.example for that copy.
#
# Nothing below is required to boot: with no keys at all the tower runs on its
# deterministic grounded reasoning and every screen still works.
# ─────────────────────────────────────────────────────────────────────────────

# ── Infrastructure ───────────────────────────────────────────────────────────
# These values are the Docker Compose service names; running outside Compose,
# point them at localhost (or drop DATABASE_URL entirely to use local SQLite).
DATABASE_URL=postgresql+asyncpg://clt:clt_secret@postgres:5432/clt_db
REDIS_URL=redis://redis:6379/0

# Seeds and continuously simulates a live network. Turn off for a real feed.
DEMO_MODE=true

# development | production. Production tightens CORS and quietens logs.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Signs session JWTs. Generate a fresh one for anything internet-facing:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=clt-super-secret-key-change-in-production-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Reasoning layer: pick either provider, or set both ───────────────────────
# ATLAS reasons, answers and acts through whichever model the operator selects
# in the AI panel. A model is only offered if its provider's key is set here, so
# one key is enough — set both and the picker groups them by provider.
#
# GOOGLE_API_KEY     Google AI Studio, calling Gemini directly.
#                    Key: https://aistudio.google.com/apikey
# OPENROUTER_API_KEY One key for Claude, GPT, Gemini, Grok, DeepSeek, Qwen, GLM,
#                    Kimi and a free NVIDIA model — all through OpenRouter.
#                    Key: https://openrouter.ai/keys
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# The model used until an operator picks another (their choice is remembered in
# Redis and wins after a restart). Google ids are bare; OpenRouter ids carry the
# vendor prefix, e.g. anthropic/claude-sonnet-5.
LLM_MODEL=gemini-3.5-flash-lite

# Master off switch for the reasoning layer. false → deterministic answers only,
# which is also the honest way to demo the AI-on / AI-off comparison.
LLM_ENABLED=true

# ── OpenRouter extras (optional) ─────────────────────────────────────────────
# Attribution only — how this app is credited on OpenRouter's dashboards.
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Centrica Logistics Control Tower

# Voice, when an OpenRouter model is the active one. The default TTS model is
# the same Gemini model used against Google direct, so ATLAS sounds identical
# either way. OpenRouter has no Gemini speech-to-text, so transcription uses a
# dedicated recogniser.
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
OPENROUTER_STT_MODEL=openai/whisper-large-v3

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Read at build time, not runtime. Compose sets these for the dev container;
# they matter when building the static site yourself. Use wss:// for the socket
# wherever the API is https://.
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
